generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Category {
  MUSIC
  WORKSHOP
  FOOD
  SPORTS
  KIDS
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  favoriteCategories FavoriteCategory[]
  reminders          EventReminder[]
  cardDesigns        EventCardDesign[]

  @@map("users")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  category    Category
  city        String
  startsAt    DateTime @map("starts_at") @db.Timestamptz()
  price       Decimal  @db.Decimal(10, 2)
  description String
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  reminders   EventReminder[]
  cardDesigns EventCardDesign[]

  @@index([isActive, startsAt])
  @@index([category])
  @@index([city])
  @@map("events")
}

model FavoriteCategory {
  userId   Int      @map("user_id")
  category Category

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("user_favorite_categories")
}

model EventReminder {
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
  @@map("event_reminders")
}

model EventCardDesign {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  theme     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stickers EventCardSticker[]

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_card_designs")
}

model EventCardSticker {
  id         Int    @id @default(autoincrement())
  designId   Int    @map("design_id")
  stickerKey String @map("sticker_key")
  position   Int

  design EventCardDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, position])
  @@map("event_card_stickers")
}
